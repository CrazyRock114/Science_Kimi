# ===== AI 后端（server/，本地开发由 npm run ai:dev 读取）=====

# OpenAI 兼容接口地址（DeepSeek / OpenAI / 自建网关均可）
# 默认 https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com

# LLM API Key（必填；缺失时 /api/tutor 与 /api/report 返回 503 llm_not_configured）
LLM_API_KEY=

# 模型名，默认 deepseek-chat
LLM_MODEL=deepseek-chat

# 允许跨域调用 AI 接口的静态站来源（如 https://yourname.github.io），默认 *
# AI_ALLOWED_ORIGIN=*

# ===== 前端（构建/开发时由 Vite 注入）=====

# AI 后端地址。本地开发指向 dev 服务器；生产部署指向云函数地址。
# 不配置时前端所有 AI 功能优雅降级（显示"AI 功能未配置"提示）。
VITE_AI_API_URL=http://localhost:8787
