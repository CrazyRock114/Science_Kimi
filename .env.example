# ===== AI 后端（server/，本地开发由 npm run ai:dev 读取）=====

# OpenAI 兼容接口地址（DeepSeek / OpenAI / 自建网关均可）
# 默认 https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com

# LLM API Key（必填；缺失时 /api/tutor 与 /api/report 返回 503 llm_not_configured）
LLM_API_KEY=

# 模型名，默认 deepseek-chat
LLM_MODEL=deepseek-chat

# 允许跨域调用 AI 接口的静态站来源（如 https://yourname.github.io）。
# 生产环境必须配置为具体域名，不要用 *：后端无鉴权，* 意味着任何网站都能
# 从浏览器直接调用并烧你的 LLM_API_KEY 额度。默认值 * 仅供本地开发。
# AI_ALLOWED_ORIGIN=https://yourname.github.io

# 按来源 IP 的限流：每 IP 每分钟最多请求次数，默认 20；设为 0 关闭（本地调试用）。
# 注意：这是云函数单实例的内存滑动窗口限流，多实例不共享计数、冷启动清零，
# 只能挡粗糙滥用；需要精确限流请在 API 网关 / Cloudflare 层配置。
# AI_RATE_LIMIT_PER_MIN=20

# ===== 前端（构建/开发时由 Vite 注入）=====

# AI 后端地址。本地开发指向 dev 服务器；生产部署指向云函数地址。
# 不配置时前端所有 AI 功能优雅降级（显示"AI 功能未配置"提示）。
VITE_AI_API_URL=http://localhost:8787
